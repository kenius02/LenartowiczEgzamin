<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portal Historyczny - Lenartowicz</title>
    <link rel="stylesheet" href="style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=IM+Fell+English+SC&family=Uncial+Antiqua&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>

<div class="countdown-container">
    <h3>Do egzaminu:</h3>
    <div id="countdown">Ładowanie...</div>
</div>

<div class="fixed-mode-toggle" id="globalModeToggle">
    <span id="toggleText">Data ➔ Wydarzenie</span>
    <label class="switch">
        <input type="checkbox" id="modeToggle" onchange="handleModeChange()">
        <span class="slider round"></span>
    </label>
</div>

<div class="container">
    <h1>📚 Historia Średniowieczna Powszechna</h1>
    
    <div class="nav-tabs">
        <button class="tab-btn active" onclick="switchTab('dates', this)">📅 Fiszki z Dat</button>
        <button class="tab-btn" onclick="switchTab('match', this)">🛡️ Dopasuj pary</button>
        <button class="tab-btn" onclick="switchTab('terms', this)">🧠 Pojęcia</button>
        <button class="tab-btn" onclick="switchTab('quiz', this)">📜 Spis Zagadnień</button>
    </div>

    <div id="tab-dates" class="tab-content active-content">
        <div class="progress-container">
            <div class="progress-bar" id="progressBar"></div>
        </div>
        <p id="progressText">Karta 1 / 1</p>

        <div class="card" id="card" onclick="flipCard()" role="button" tabindex="0" aria-label="Obróć kartę dat">
            <div class="card-inner">
                <div class="card-front">
                    <span class="label">DATA</span>
                    <h2 id="front"></h2>
                    <p>Kliknij kartę lub wciśnij Spację</p>
                </div>
                <div class="card-back">
                    <span class="label">WYDARZENIE</span>
                    <h2 id="event"></h2>
                    <p id="desc"></p>
                </div>
            </div>
        </div>

        <div class="buttons">
            <button class="good-btn" onclick="answer(true); event.stopPropagation();">✅ Umiem (➔ / D)</button>
            <button class="bad-btn" onclick="answer(false); event.stopPropagation();">❌ Nie umiem (⬅ / A)</button>
        </div>

        <div class="stats">
            <div class="stat-card">
                <span>Opanowane</span>
                <h3 id="goodCount">0</h3>
            </div>
            <div class="stat-card">
                <span>Do powtórki</span>
                <h3 id="badCount">0</h3>
            </div>
        </div>

        <div class="cheat-sheet-section">
            <button onclick="toggleCheatSheet()" class="btn btn-secondary toggle-btn" aria-label="Otwórz szybką ściągawkę">
                🔍 Otwórz szybką ściągawkę (Baza dat)
            </button>
            <div id="cheatSheetContainer" class="cheat-sheet-container hidden">
                <input type="text" id="cheatSearch" class="search-input" oninput="searchCheatSheet()" placeholder="Wpisz rok lub słowo kluczowe..." aria-label="Wyszukaj w bazie dat">
                <div class="table-wrapper">
                    <table id="cheatTable">
                        <thead>
                            <tr><th>Data</th><th>Wydarzenie</th><th>Opis</th></tr>
                        </thead>
                        <tbody id="cheatTableBody"></tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>

    <div id="tab-terms" class="tab-content">
        <div class="progress-container"><div class="progress-bar" id="progressBarTerms"></div></div>
        <p id="progressTextTerms">Pojęcie 1 / 1</p>

        <div class="card term-card" id="termCard" onclick="flipTermCard()" role="button" tabindex="0" aria-label="Obróć kartę pojęcia">
            <div class="card-inner">
                <div class="card-front">
                    <span class="label" id="termLabelFront">POJĘCIE</span>
                    <h2 id="termFront" class="term-title"></h2>
                    <p class="card-hint">Kliknij, aby odkryć wyjaśnienie</p>
                </div>
                <div class="card-back">
                    <span class="label" id="termLabelBack">WYJAŚNIENIE</span>
                    <p id="termDesc" class="term-description"></p>
                </div>
            </div>
        </div>

        <div class="buttons">
            <button class="good-btn" onclick="answerTerm(true); event.stopPropagation();">✅ Umiem</button>
            <button class="bad-btn" onclick="answerTerm(false); event.stopPropagation();">❌ Nie umiem</button>
        </div>

        <div class="stats">
            <div class="stat-card"><span>Opanowane</span><h3 id="goodCountTerms">0</h3></div>
            <div class="stat-card"><span>Do powtórki</span><h3 id="badCountTerms">0</h3></div>
        </div>
    </div>

    <div id="tab-match" class="tab-content">
        <div class="match-panel">
            <div class="match-header">
                <div id="matchStatus" class="match-status">Uruchom grę i dopasuj pary.</div>
                <button id="startMatchBtn" onclick="startMatchingPairs()" class="btn btn-primary">Rozpocznij</button>
            </div>
            <p class="section-note">Wszystkie karty są widoczne od razu. Kliknij dwie pasujące do siebie karty: datę i wydarzenie.</p>
            <div id="matchContainer" class="match-container hidden">
                <div id="matchBoard" class="match-board"></div>
                <button id="matchRestartBtn" onclick="startMatchingPairs()" class="btn btn-primary btn-full hidden">
                    🔄 Spróbuj ponownie
                </button>
            </div>
        </div>
    </div>

    <div id="tab-quiz" class="tab-content">
        <div class="action-bar">
            <button id="startQuizBtn" onclick="startQuiz()" class="btn btn-primary btn-full quiz-start-btn" aria-label="Uruchom interaktywny quiz">
                🎯 Uruchom interaktywny Quiz ABCD / Prawda-Fałsz
            </button>
            <button id="backToTopicsBtn" onclick="exitQuiz()" class="btn btn-secondary btn-full" aria-label="Zamknij test i wróć do spisu zagadnień">
                ⬅️ Zamknij test i wróć do spisu zagadnień
            </button>
        </div>

        <div id="topicsList">
            <p class="section-note">Kliknij interesujące Cię zagadnienie opisowe z egzaminu, aby rozwinąć pigułkę wiedzy.</p>
            <input type="text" id="vademecumSearch" class="search-input" oninput="searchVademecum()" placeholder="Wyszukaj zagadnienie (np. Krucjaty, Frankowie)..." aria-label="Wyszukaj zagadnienie">
            <div id="vademecumAccordion" class="accordion-container"></div>
        </div>

        <div id="quizContainer" class="quiz-panel hidden">
            <div id="quizProgress" class="quiz-progress"></div>
            <h3 id="quizQuestion" class="quiz-question"></h3>
            <div id="quizAnswers" class="quiz-answers"></div>
            <div id="quizFeedback" class="quiz-feedback" aria-live="polite"></div>
            <button id="nextQuestionBtn" onclick="nextQuestion()" class="btn btn-primary btn-full quiz-nav-btn hidden">
                Następne pytanie ➡️
            </button>
        </div>
    </div>

</div>

<div id="restoreModal" class="modal" style="display: none;">
    <div class="modal-content">
        <h2>⏱️ Przerwana nauka</h2>
        <p>Masz zapisaną niedokończoną sesję dat.</p>
        <p id="restoreModalText" class="modal-text">Karta X / Y</p>
        <hr>
        <div class="modal-actions">
            <button onclick="handleRestoreDecision(true)" class="btn btn-primary">Kontynuuj</button>
            <button onclick="handleRestoreDecision(false)" class="btn btn-secondary">Od nowa</button>
        </div>
    </div>
</div>

<div id="confirmModal" class="modal" style="display: none;">
    <div class="modal-content">
        <h2 class="modal-warning-heading">⚠️ Zmiana trybu</h2>
        <p>Zmiana trybu w trakcie nauki zresetuje Twój obecny postęp i wymiesza karty od nowa.</p>
        <hr>
        <div class="modal-actions">
            <button onclick="confirmResetAction(true)" class="btn btn-danger">Tak, resetuj</button>
            <button onclick="confirmResetAction(false)" class="btn btn-secondary">Anuluj</button>
        </div>
    </div>
</div>

<div id="statsModal" class="modal" style="display: none;">
    <div class="modal-content">
        <h2>🎉 Gratulacje!</h2>
        <p id="statsModalType">Przerobiłeś całą bazę.</p>
        <hr>
        <div class="modal-stats-details">
            <p>📊 <strong>Łącznie:</strong> <span id="modalTotal">0</span></p>
            <p>✨ <strong>Za 1. razem:</strong> <span id="modalCorrect">0</span></p>
            <p>🎯 <strong>Wskaźnik zapamiętania:</strong> <span id="modalAccuracy">0</span>%</p>
        </div>
        <button onclick="closeModal()" class="btn btn-primary btn-full" style="margin-top: 20px;">Zacznij od nowa</button>
    </div>
</div>

<script src="script.js"></script>
</body>
</html>

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    /* Ustawiamy tło na 20% szerokości obrazu, zamiast na środek (50%) */
    background: linear-gradient(135deg, rgba(15, 23, 42, 0.85), rgba(30, 41, 59, 0.85)), 
                url(grafika/image.png) 75% center/cover no-repeat fixed;
    min-height: 100vh;
    font-family: 'Poppins', sans-serif;
    color: white;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding: 40px 20px 20px;
}

.container {
    width: 100%;
    max-width: 700px;
    text-align: center;
}

h1 {
    font-family: 'Cormorant Garamond', 'IM Fell English SC', 'Uncial Antiqua', serif;
    font-weight: 700;
    font-size: 1.6rem;
    margin-bottom: 25px;
    color: #fffbe6;
    text-shadow: 0 2px 0 rgba(0,0,0,0.45);
}

/* === NOWY PRZYPIĘTY PRZEŁĄCZNIK W ROGU === */
.fixed-mode-toggle {
    position: fixed;
    top: 20px;
    right: 20px;
    z-index: 1000;
    display: flex;
    align-items: center;
    gap: 12px;
    background: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(8px);
    padding: 8px 18px;
    border-radius: 50px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 4px 15px rgba(0,0,0,0.2);
}

#toggleText {
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.5px;
    opacity: 0.85;
}

/* Nowoczesny, smuklejszy slider */
.switch {
    position: relative;
    display: inline-block;
    width: 40px;
    height: 20px;
}

.switch input {
    opacity: 0;
    width: 0;
    height: 0;
}

.slider {
    position: absolute;
    cursor: pointer;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(255, 255, 255, 0.15);
    transition: .3s ease;
    border-radius: 34px;
}

.slider:before {
    position: absolute;
    content: "";
    height: 14px;
    width: 14px;
    left: 3px;
    bottom: 3px;
    background-color: white;
    transition: .3s cubic-bezier(0.4, 0, 0.2, 1);
    border-radius: 50%;
    box-shadow: 0 2px 5px rgba(0,0,0,0.3);
}

input:checked + .slider {
    background-color: #8b5cf6;
}

input:checked + .slider:before {
    transform: translateX(20px);
}

/* === PASEK POSTĘPU === */
.progress-container {
    width: 100%;
    height: 10px;
    background: rgba(255, 255, 255, .1);
    border-radius: 20px;
    overflow: hidden;
}

.progress-bar {
    height: 100%;
    width: 0%;
    background: #8b5cf6;
    transition: .3s;
}

#progressText {
    margin-top: 10px;
    margin-bottom: 20px;
    opacity: .8;
}

/* === KARTA === */
.card {
    perspective: 1000px;
    width: 100%;
    height: 350px;
    cursor: pointer;
    pointer-events: auto;
}

.card-inner {
    width: 100%;
    height: 100%;
    position: relative;
    transition: transform 0.55s cubic-bezier(0.4, 0, 0.2, 1);
    transform-style: preserve-3d;
    pointer-events: auto;
}

.card.flipped .card-inner,
.term-card.flipped .card-inner,
.card-inner.flipped {
    transform: rotateY(180deg);
}

.card-hint {
    margin-top: 16px;
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.95rem;
    opacity: 0.95;
    transition: transform 0.2s ease, opacity 0.2s ease;
}

.card:hover .card-hint {
    transform: translateY(-2px);
    opacity: 1;
}

.card-front,
.card-back {
    position: absolute;
    width: 100%;
    height: 100%;
    border-radius: 25px;
    padding: 30px;
    backface-visibility: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background: rgba(255, 255, 255, .08);
    backdrop-filter: blur(15px);
    box-shadow: 0 0 30px rgba(139, 92, 246, .3);
    pointer-events: auto;
    cursor: pointer;
}

.card-back {
    transform: rotateY(180deg);
}

.label {
    font-size: .8rem;
    letter-spacing: 2px;
    opacity: .7;
    margin-bottom: 15px;
}

.card-front h2 {
    font-size: 3rem;
}

.card-back h2 {
    margin-bottom: 15px;
}

.card-back p {
    line-height: 1.6;
}

/* === PRZYCISKI === */
.buttons {
    margin-top: 25px;
    display: flex;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
}

button {
    border: none;
    padding: 14px 22px;
    border-radius: 12px;
    cursor: pointer;
    color: white;
    font-weight: 600;
    transition: .2s;
    display: inline-flex;
    align-items: center;
}

button:hover {
    transform: translateY(-2px);
}

button:focus-visible {
    outline: 2px solid rgba(167, 139, 246, 0.8);
    outline-offset: 3px;
}

div[role="button"]:focus-visible {
    outline: 3px solid rgba(167, 139, 246, 0.9);
    outline-offset: 3px;
}

.btn {
    border: none;
    padding: 14px 22px;
    border-radius: 14px;
    cursor: pointer;
    color: white;
    font-weight: 600;
    transition: transform .2s, box-shadow .2s, background-color .2s;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 48px;
}

.btn-full {
    width: 100%;
}

.btn-primary {
    background: #8b5cf6;
    color: white;
}

.btn-secondary {
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.14);
    color: white;
}

.btn-danger {
    background: #ef4444;
}

.btn-secondary:hover,
.btn-primary:hover,
.btn-danger:hover {
    box-shadow: 0 12px 30px rgba(0,0,0,0.18);
}

.toggle-btn {
    margin: 20px auto 0 auto;
    padding: 10px 20px;
    font-size: 0.95rem;
    max-width: 420px;
}

.match-section {
    margin-top: 30px;
}

.match-panel {
    margin-top: 20px;
    padding: 20px;
    background: rgba(15, 23, 42, 0.85);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 22px;
}

.match-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-bottom: 18px;
    flex-wrap: wrap;
}

.match-status {
    font-weight: 600;
    color: #d8b4fe;
    letter-spacing: 0.02em;
}

.match-board {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 20px;
    align-items: start;
}

.match-column {
    display: grid;
    gap: 15px;
}

.match-column h3 {
    margin: 0;
    color: #f8f4ff;
    font-size: 1.05rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    opacity: 0.95;
}

.match-column .match-card {
    background: rgba(255,255,255,0.1);
    border-color: rgba(255,255,255,0.14);
    min-height: 90px;
    padding: 20px 16px;
    align-items: flex-start;
    justify-content: flex-start;
    text-align: left;
}

.match-card {
    border-radius: 18px;
    cursor: pointer;
    transition: transform .2s ease, background .2s ease, border-color .2s ease, box-shadow .2s ease;
    color: white;
    overflow: hidden;
}

.match-card span {
    z-index: 1;
    opacity: 1;
    font-weight: 700;
    color: white;
    line-height: 1.25;
}

.match-card.selected,
.match-card.matched {
    transform: translateY(-2px);
    border-color: rgba(167,139,246,0.9);
    background: rgba(139,92,246,0.18);
}

.match-card.matched {
    background: rgba(22,163,74,0.2);
    border-color: #22c55e;
    cursor: default;
    pointer-events: none;
}

@media (max-width: 900px) {
    .match-board {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 700px) {
    .match-card {
        min-height: 80px;
    }
}

/* Highlight for quiz back button */
.highlight {
    animation: highlightPulse 1.6s ease-in-out 0s 3;
    box-shadow: 0 8px 30px rgba(139,92,246,0.35), 0 0 0 4px rgba(139,92,246,0.12) inset;
    border-color: #9f7aea !important;
}

@keyframes highlightPulse {
    0% { transform: translateY(0); box-shadow: 0 6px 20px rgba(139,92,246,0.15); }
    50% { transform: translateY(-4px); box-shadow: 0 18px 40px rgba(139,92,246,0.28); }
    100% { transform: translateY(0); box-shadow: 0 6px 20px rgba(139,92,246,0.15); }
}

.hidden {
    display: none !important;
}

.search-input {
    width: 100%;
    padding: 14px 18px;
    margin-bottom: 20px;
    border-radius: 14px;
    background: rgba(15, 23, 42, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: white;
    font-family: 'Poppins', sans-serif;
    font-size: 0.95rem;
    outline: none;
    transition: border-color .2s, box-shadow .2s;
}

.search-input:focus {
    border-color: #8b5cf6;
    box-shadow: 0 0 14px rgba(139, 92, 246, 0.22);
}

.action-bar {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 25px;
}

.section-note {
    text-align: center;
    opacity: 0.78;
    margin-bottom: 20px;
    line-height: 1.6;
}

.modal-text {
    font-weight: 500;
    margin: 10px 0;
}

.modal-actions {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
}

.modal-warning-heading {
    color: #f59e0b;
}

.quiz-panel {
    display: none;
    background: rgba(15, 24, 39, 0.92);
    padding: 28px;
    border-radius: 22px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.35);
}

.quiz-progress {
    font-size: 0.95rem;
    color: #94a3b8;
    margin-bottom: 12px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.quiz-question {
    margin-bottom: 25px;
    font-size: 1.35rem;
    line-height: 1.55;
    color: #f8fafc;
}

.quiz-answers {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.quiz-feedback {
    margin-top: 20px;
    padding: 15px;
    border-radius: 10px;
    display: none;
    font-weight: 700;
    line-height: 1.4;
    background: rgba(51, 65, 85, 0.9);
    color: #f8fafc;
}

.quiz-nav-btn {
    margin-top: 25px;
    width: 100%;
    border-radius: 10px;
}

.term-title {
    font-size: 1.9rem;
}

.term-description {
    font-size: 1.05rem;
    line-height: 1.7;
    padding: 0 10px;
    text-align: left;
}

.tab-content.active-content {
    background: rgba(15, 23, 42, 0.45);
    border-radius: 24px;
    padding: 24px;
}

.tab-content.active-content .progress-container {
    margin-top: 10px;
}

.tab-btn {
    transition: transform .2s, box-shadow .2s;
}

.tab-btn:hover {
    transform: translateY(-2px);
}

.good-btn {
    background: #10b981;
}

.bad-btn {
    background: #ef4444;
}

.bad-btn {
    background: #ef4444;
}

/* === STATYSTYKI === */
.stats {
    display: flex;
    gap: 15px;
    justify-content: center;
    margin-top: 25px;
}

.stat-card {
    background: rgba(255, 255, 255, .08);
    padding: 20px;
    border-radius: 15px;
    min-width: 150px;
}

.stat-card h3 {
    margin-top: 8px;
    font-size: 1.8rem;
}

/* === STYL MODALI === */
.modal {
    position: fixed; 
    z-index: 9999; 
    left: 0; top: 0;
    width: 100vw; height: 100vh;
    background-color: rgba(15, 23, 42, 0.75); 
    backdrop-filter: blur(10px);
    display: flex;
    justify-content: center;
    align-items: center;
}

.modal-content {
    background: rgba(30, 41, 59, 0.95);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 30px;
    border-radius: 25px;
    width: 90%;
    max-width: 450px;
    text-align: center;
    box-shadow: 0 0 40px rgba(139, 92, 246, 0.4);
    animation: fadeIn 0.3s ease-out;
}

.modal-content h2 {
    margin-bottom: 12px;
}

.modal-content hr {
    border: 0;
    height: 1px;
    background: rgba(255, 255, 255, 0.1);
    margin: 20px 0;
}

.modal-stats-details {
    text-align: left;
    display: inline-block;
}

.modal-stats-details p {
